# Non-secret local CDK settings. Copy to .env.local; never commit that file.
WORLD_EVERY_DAY_ENVIRONMENT=development
WORLD_EVERY_DAY_ENABLE_SCHEDULE=false
# Gemini editorial analysis reuses the existing Google secret. Bedrock and
# Vertex Claude remain optional; synth never calls a model.
WORLD_EVERY_DAY_EDITORIAL_PROVIDER=google-gemini
WORLD_EVERY_DAY_GEMINI_EDITORIAL_MODEL=gemini-3.8-flash
WORLD_EVERY_DAY_EDITORIAL_MODEL=amazon.nova-lite-v1:0
WORLD_EVERY_DAY_ARTICLE_ANALYSIS_MODEL=amazon.nova-lite-v1:0
WORLD_EVERY_DAY_VERTEX_PROJECT_ID=
WORLD_EVERY_DAY_VERTEX_PROJECT_NUMBER=
WORLD_EVERY_DAY_VERTEX_WIF_POOL_ID=
WORLD_EVERY_DAY_VERTEX_WIF_PROVIDER_ID=
WORLD_EVERY_DAY_VERTEX_SERVICE_ACCOUNT_EMAIL=
WORLD_EVERY_DAY_VERTEX_LOCATION=
WORLD_EVERY_DAY_VERTEX_CLAUDE_MODEL=claude-haiku-4-5
WORLD_EVERY_DAY_LANDMARK_VISION_MODEL=gemini-3.8-flash
WORLD_EVERY_DAY_NANO_BANANA_MODEL=gemini-nano-banana-2.1
WORLD_EVERY_DAY_WORLD_LABS_MODEL=marble-1.1
WORLD_EVERY_DAY_ALARM_EMAIL=
WORLD_EVERY_DAY_MONTHLY_BUDGET_USD=
WORLD_EVERY_DAY_BUDGET_ALERT_EMAIL=
CDK_DEFAULT_REGION=us-east-1

# Optional custom-domain hosting. Set the domain and Route 53 hosted-zone ID
# together. CloudFront certificates require this stack to deploy in us-east-1.
WORLD_EVERY_DAY_SITE_DOMAIN=
WORLD_EVERY_DAY_HOSTED_ZONE_ID=
WORLD_EVERY_DAY_EXPLORER_SUBDOMAIN=explore

# Do not put AWS access keys or provider API keys here.
# Use an AWS CLI named profile for CDK and AWS Secrets Manager for providers.
