# The first frontend milestone uses checked-in fictional fixture data and needs no
# credentials. Future server-only provider credentials will be documented here.
# Never prefix a secret with NEXT_PUBLIC_.

# Optional public URL for a Marble-generated splat asset. Spark.js supports common
# formats including .spz, .ply, .sog/.zip, .splat, and .ksplat. The asset host
# must allow browser CORS requests. This URL is public by design and is not a key.
NEXT_PUBLIC_WORLD_SPLAT_URL=

# Required with a local splat override before baked 3D hotspots are shown. This
# prevents interaction coordinates from one world appearing over another.
NEXT_PUBLIC_WORLD_SPLAT_SHA256=

# Public destination for the explorer's "About the project" link.
NEXT_PUBLIC_PROJECT_SITE_URL=https://aworldeveryday.com

# Optional local World Guide backend URL. Leave blank for the public disabled
# state. The backend URL is public configuration, not a credential.
NEXT_PUBLIC_WORLD_GUIDE_BACKEND_URL=
# Hosted API URL emitted by CDK. Public URL only; backend checks the exact app
# origin and enforces server-side limits. Production uses this path, never the
# browser-visible agent ID below.
NEXT_PUBLIC_WORLD_GUIDE_API_URL=
# Public agent ID used by the local browser SDK; never put provider API keys here.
NEXT_PUBLIC_WORLD_GUIDE_AGENT_ID=
# Explicit production opt-in. Set true only with a secured, hosted backend and
# a reviewed provider cost/access policy. Rebuild and redeploy to change this.
NEXT_PUBLIC_WORLD_GUIDE_ENABLED=false

# Optional server-side filename for an ignored publication manifest stored in
# public/generated and assembled from a generated edition, world, and hotspots.
LOCAL_PUBLICATION_MANIFEST=

