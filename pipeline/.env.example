# Server-side credential used only when a paid panorama generation is requested.
# In AWS, inject this value from Secrets Manager. Never expose it to the browser.
GOOGLE_AI_API_KEY=

# Model identifiers are configuration because provider aliases can change.
NANO_BANANA_MODEL=gemini-nano-banana-2.1

# Multimodal model used to locate story landmarks in the generated panorama.
# Keep this server-side; the detector adapter is optional and replaceable.
LANDMARK_VISION_MODEL=

# Optional multimodal/text model used to evaluate candidates and analyze
# permitted article text after preliminary selection.
EDITORIAL_MODEL=

# Text model used to transform the selected edition into structured art direction.
ART_DIRECTION_MODEL=

# Server-only key for the optional World Labs adapter. The mock world lifecycle
# does not require it. A live generation must always be deliberately approved.
WORLD_LABS_KEY=

# Optional provider model override for World Labs generation.
WORLD_LABS_MODEL=marble-1.1
