# Server-side credential for Gemini editorial analysis, Nano Banana, and
# landmark detection. Editorial use requires a billing-enabled project.
# In AWS, inject this value from Secrets Manager. Never expose it to the browser.
GOOGLE_AI_API_KEY=

# Model identifiers are configuration because provider aliases can change.
NANO_BANANA_MODEL=gemini-nano-banana-2.1

# Multimodal model used to locate story landmarks in the generated panorama.
# Keep this server-side; the detector adapter is optional and replaceable.
LANDMARK_VISION_MODEL=gemini-3.8-flash

# Default local editorial route. The same Google key is used by all Google stages.
EDITORIAL_PROVIDER=google-gemini
GEMINI_EDITORIAL_MODEL=gemini-3.8-flash

# Optional Amazon-operated Bedrock model settings.
EDITORIAL_MODEL=amazon.nova-lite-v1:0

# Used only when EDITORIAL_PROVIDER=aws-bedrock.
ARTICLE_ANALYSIS_MODEL=amazon.nova-lite-v1:0

ART_DIRECTION_MODEL=amazon.nova-lite-v1:0

# Server-only key for the optional World Labs adapter. The mock world lifecycle
# does not require it. A live generation must always be deliberately approved.
WORLD_LABS_KEY=

# Optional provider model override for World Labs generation.
WORLD_LABS_MODEL=marble-1.1

# Optional daily X publication (server-only OAuth 2.0 confidential client).
# Cloud setup and enablement: docs/DAILY_X_POSTS.md. App-only bearer is not used.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH2_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# Alternative OAuth 1.0a credentials; do not mix the two token types.
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
