# Server-side credential for Gemini editorial analysis, Nano Banana, and
# landmark detection. Editorial use requires a billing-enabled project.
# In AWS, inject this value from Secrets Manager. Never expose it to the browser.
GOOGLE_AI_API_KEY=

# Model identifiers are configuration because provider aliases can change.
NANO_BANANA_MODEL=gemini-nano-banana-2.1

# Multimodal model used to locate story landmarks in the generated panorama.
# Keep this server-side; the detector adapter is optional and replaceable.
LANDMARK_VISION_MODEL=gemini-3.8-flash

# Default local editorial route. The same Google key is used by all Google stages.
EDITORIAL_PROVIDER=google-gemini
GEMINI_EDITORIAL_MODEL=gemini-3.8-flash

# Optional Amazon-operated Bedrock model settings.
EDITORIAL_MODEL=amazon.nova-lite-v1:0

# Used only when EDITORIAL_PROVIDER=aws-bedrock.
ARTICLE_ANALYSIS_MODEL=amazon.nova-lite-v1:0

ART_DIRECTION_MODEL=amazon.nova-lite-v1:0

# Server-only key for the optional World Labs adapter. The mock world lifecycle
# does not require it. A live generation must always be deliberately approved.
WORLD_LABS_KEY=

# Optional provider model override for World Labs generation.
WORLD_LABS_MODEL=marble-1.1

# Optional daily X publication (server-only OAuth 2.0 confidential client).
# Cloud setup and enablement: docs/DAILY_X_POSTS.md. App-only bearer is not used.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH2_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# Alternative OAuth 1.0a credentials; do not mix the two token types.
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional local World Guide lease/research backend. Keep it disabled until an
# ElevenLabs agent exists and its privacy settings have been reviewed. The
# browser connects directly with the public agent ID; no ElevenLabs API key is
# needed by this local flow.
WORLD_GUIDE_ENABLED=false
# Separate paid research opt-in. Only enable after reviewing source policy,
# provider data handling, and cost; confirmation is an operator attestation.
WORLD_GUIDE_RESEARCH_ENABLED=false
WORLD_GUIDE_RESEARCH_CONFIRMED=false
# When explicitly enabled, article text is fetched only after a visitor asks a
# question, held in backend memory, and sent to this configured Gemini model.
# Provider processing/retention follows your Google account and terms.
WORLD_GUIDE_RESEARCH_MODEL=gemini-3.8-flash
WORLD_GUIDE_ALLOWED_ORIGIN=http://localhost:3000
WORLD_GUIDE_PORT=8787
# Set true only after confirming direct agent-ID connections work and are
# intended for local use. This does not restrict who can connect to ElevenLabs.
WORLD_GUIDE_AGENT_DIRECT_ACCESS_CONFIRMED=false
# Configure max_duration_seconds=600 in the agent before confirming this limit.
WORLD_GUIDE_AGENT_DURATION_CONFIRMED=false
# Set true only after confirming audio saving off, transcript retention at the
# shortest appropriate setting, and account training/data-use opt-out.
WORLD_GUIDE_PRIVACY_CONFIRMED=false

# Structured panorama quality review; up to five image candidates, then fail closed.
PANORAMA_REVIEW_MODEL=gemini-3.8-flash
